# Copy this file to `.env` and fill in your Supabase project values.
# Settings -> API in the Supabase dashboard.
# NOTE: EXPO_PUBLIC_* vars are embedded in the app bundle. The anon key is
# safe to ship (it relies on Row Level Security). NEVER put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
